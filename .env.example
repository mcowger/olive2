OLIVE_CONFIG_DIR=
OLIVE_MEETINGS_DIR=
OLIVE_MODELS_DIR=
OLIVE_BIND_HOST=127.0.0.1
OLIVE_BIND_PORT=4471

# Optional authentication & integrations:
# HF_TOKEN=
# OLIVE_INGEST_TOKEN=
# OLIVE_MCP_TOKEN=                  # Falls back to OLIVE_INGEST_TOKEN; loopback may be unauthenticated
# OLIVE_MCP_WRITE=1                 # Off by default; enables MCP write tools (update/merge/delete speakers, set tags, rename titles)
# OLIVE_STAGE_TIMEOUT_SEC=          # Absolute deadline for every local transcription stage (overrides per-stage defaults: decode 600s, diarize 3600s, speaker match 600s, ASR 7200s, align 1800s)
# OLIVE_DBOS_MAX_EXECUTOR_THREADS=  # Cap on DBOS executor threads (defaults to the sum of queue concurrencies + 16)
# PLAUD_TOKEN_PATH=~/.plaud/tokens.json
# SPEECHMATICS_API_KEY=               # Optional: overrides the Speechmatics key in Settings UI
# SPEECHMATICS_WEBHOOK_SECRET=
# ASSEMBLY_API_KEY=                  # Optional: overrides the AssemblyAI key in Settings UI (ASSEMBLYAI_API_KEY also accepted)
# MUSE_API_KEY=                      # Optional: overrides the Muse Voice key in Settings UI (MODEL_API_KEY also accepted)
